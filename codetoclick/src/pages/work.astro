---
import Base from '../layouts/Base.astro';
const title = "Work — Code to Click";
const description = "Selected Salesforce and Marketing Cloud outcomes across Higher Education, Nonprofit, Professional Services and Retail.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Work</div>
    <span class="eyebrow kick">Selected work</span>
    <h1>Outcomes, <span class="g">not just deliverables</span></h1>
    <p class="lede">A sample of the results we deliver. These are placeholder stories &mdash; we'll replace them with your real client case studies and metrics during content load.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Start your project &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="grid g3 reveal">
      <div class="card hover" style="padding:0;overflow:hidden"><div class="thumb" style="background:linear-gradient(135deg,#22D3EE,#2F6BFF)"><span class="metric">-38%</span></div><div style="padding:22px 24px 26px"><span class="klabel">Higher Education &middot; MCE</span><h4 style="margin:8px 0 6px">Enrollment journeys, rebuilt</h4><p style="color:var(--text-muted);font-size:14px;margin:0">Cut campaign build time 38% with AI-assisted Journey Builder templates.</p><div class="ph-note">// placeholder</div></div></div>
      <div class="card hover" style="padding:0;overflow:hidden"><div class="thumb" style="background:linear-gradient(135deg,#2F6BFF,#8B5CF6)"><span class="metric">3&times;</span></div><div style="padding:22px 24px 26px"><span class="klabel">Retail &middot; Data 360</span><h4 style="margin:8px 0 6px">One profile, every channel</h4><p style="color:var(--text-muted);font-size:14px;margin:0">Unified identity across web, POS and email &mdash; 3&times; faster segment builds.</p><div class="ph-note">// placeholder</div></div></div>
      <div class="card hover" style="padding:0;overflow:hidden"><div class="thumb" style="background:linear-gradient(135deg,#8B5CF6,#22D3EE)"><span class="metric">6 wks</span></div><div style="padding:22px 24px 26px"><span class="klabel">Nonprofit &middot; Agentforce</span><h4 style="margin:8px 0 6px">Support agent, live in 6 weeks</h4><p style="color:var(--text-muted);font-size:14px;margin:0">Deployed an Agentforce donor-support agent in a single sprint cycle.</p><div class="ph-note">// placeholder</div></div></div>
      <div class="card hover" style="padding:0;overflow:hidden"><div class="thumb" style="background:linear-gradient(135deg,#2F6BFF,#22D3EE)"><span class="metric">+22%</span></div><div style="padding:22px 24px 26px"><span class="klabel">Prof. Services &middot; MCAE</span><h4 style="margin:8px 0 6px">Nurture that fills pipeline</h4><p style="color:var(--text-muted);font-size:14px;margin:0">Rebuilt scoring and nurture; +22% marketing-sourced pipeline.</p><div class="ph-note">// placeholder</div></div></div>
      <div class="card hover" style="padding:0;overflow:hidden"><div class="thumb" style="background:linear-gradient(135deg,#22D3EE,#8B5CF6)"><span class="metric">-45%</span></div><div style="padding:22px 24px 26px"><span class="klabel">Higher Education &middot; Data 360</span><h4 style="margin:8px 0 6px">Melt cut with better timing</h4><p style="color:var(--text-muted);font-size:14px;margin:0">Reduced summer melt with a data-driven yield journey.</p><div class="ph-note">// placeholder</div></div></div>
      <div class="card hover" style="padding:0;overflow:hidden"><div class="thumb" style="background:linear-gradient(135deg,#8B5CF6,#2F6BFF)"><span class="metric">2 sprints</span></div><div style="padding:22px 24px 26px"><span class="klabel">Retail &middot; MCE &rarr; Next</span><h4 style="margin:8px 0 6px">Migrated without downtime</h4><p style="color:var(--text-muted);font-size:14px;margin:0">Staged MCE to Marketing Cloud Next move with zero disruption.</p><div class="ph-note">// placeholder</div></div></div>
    </div>
    <div class="note reveal" style="margin-top:26px"><span class="mono">Note &rarr;</span><span>Send your real client wins &mdash; industry, challenge, what we built, and one measurable result each &mdash; and we'll turn these into full case studies.</span></div>
  </div>
</section>

<section class="blk alt" style="padding-top:60px;padding-bottom:60px"><div class="wrap"><div class="ctaband reveal">
  <h2>Your project could be the next story.</h2>
  <p>Let's scope it and get building.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/marketing-cloud">Explore services</a></div>
</div></div></section>
</Base>
