<script is:inline>
  (function(){
    var nums = document.querySelectorAll('.count[data-count]');
    if (!nums.length) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function run(el){
      var target = parseFloat(el.getAttribute('data-count')) || 0;
      var suffix = el.getAttribute('data-suffix') || '';
      var prefix = el.getAttribute('data-prefix') || '';
      if (reduce) { el.textContent = prefix + target + suffix; return; }
      var dur = 1100, start = null;
      function tick(ts){
        if (start === null) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = prefix + Math.round(eased * target) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    if (!('IntersectionObserver' in window)) { nums.forEach(run); return; }
    var io = new IntersectionObserver(function(en){
      en.forEach(function(e){ if (e.isIntersecting){ run(e.target); io.unobserve(e.target); } });
    }, { threshold: .5 });
    nums.forEach(function(n){ io.observe(n); });
  })();
</script>

<script is:inline>
  (function(){
    var exp = document.getElementById('explorer');
    if (!exp) return;
    var tabs = Array.prototype.slice.call(exp.querySelectorAll('.exp-tab'));
    var panels = Array.prototype.slice.call(exp.querySelectorAll('.exp-panel'));
    var bars = tabs.map(function(t){ return t.querySelector('.et-bar i'); });
    var n = tabs.length, i = 0, timer = null, t0 = 0, raf = null;
    var DUR = 5200;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function paint(idx){
      for (var k = 0; k < n; k++){
        var on = k === idx;
        tabs[k].classList.toggle('active', on);
        tabs[k].setAttribute('aria-selected', on ? 'true' : 'false');
        panels[k].classList.toggle('active', on);
        if (bars[k]) bars[k].style.width = on ? '0%' : '0%';
      }
    }
    function go(idx){ i = (idx + n) % n; paint(i); }
    function tickBar(ts){
      if (!t0) t0 = ts;
      var p = Math.min((ts - t0) / DUR, 1);
      if (bars[i]) bars[i].style.width = (p * 100) + '%';
      if (p >= 1){ t0 = 0; go(i + 1); }
      raf = requestAnimationFrame(tickBar);
    }
    function start(){ if (reduce) return; stop(); t0 = 0; raf = requestAnimationFrame(tickBar); }
    function stop(){ if (raf){ cancelAnimationFrame(raf); raf = null; } if (bars[i]) bars[i].style.width = '0%'; }
    function restart(){ stop(); start(); }

    tabs.forEach(function(t){
      t.addEventListener('click', function(){ go(+t.getAttribute('data-i')); restart(); });
      t.addEventListener('mouseenter', function(){ go(+t.getAttribute('data-i')); stop(); });
    });
    exp.addEventListener('mouseleave', start);
    exp.addEventListener('focusin', stop);
    exp.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : start(); });

    go(0);
    start();
  })();
</script>

<script is:inline>
  (function(){
    var steps = document.querySelectorAll('.console .cstep');
    if (!steps.length) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    var bar = document.querySelector('.console .bar i');
    if (bar) bar.style.animation = 'none';
    var idx = 0;
    setInterval(function(){
      steps.forEach(function(s){ s.classList.remove('on'); });
      idx = (idx + 1) % steps.length;
      steps[idx].classList.add('on');
      if (bar) bar.style.width = (14 + (idx / (steps.length - 1)) * 74) + '%';
    }, 1900);
  })();
</script>
