---
import Base from '../layouts/Base.astro';
const title = "About — AI-First Salesforce Consultancy | Code to Click";
const description = "Code to Click is a Salesforce-first, AI-native delivery partner. Our story, what we stand for, and how we work.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / About</div>
    <span class="eyebrow kick">About us</span>
    <h1>An AI-first Salesforce <span class="g">consultancy</span></h1>
    <p class="lede">Code to Click helps organizations adopt AI, transform how they work, and get more from Salesforce &mdash; faster. AI isn&rsquo;t a feature we add at the end; it&rsquo;s the pillar everything we do is built on, from the first workshop to the last release.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Work with us &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="frow reveal">
      <div>
        <span class="eyebrow">Our story</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">One platform, done exceptionally well</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">We started Code to Click on a simple belief: a focused team that lives and breathes Salesforce &mdash; and uses AI to move faster &mdash; delivers better outcomes than a generalist shop. We help brands build on Salesforce directly, and we extend the capacity of other Salesforce partners as their delivery arm.</p>
        <p style="color:var(--text-muted);margin:14px 0 0">Marketing Cloud is our flagship, with deep experience across Higher Education, Nonprofit, Professional Services and Retail.</p>
      </div>
      <div class="fig soft"><div class="imgslot"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="1.5"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2.5"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5M15 20c0-2 2-3.5 4-3.5"/></svg></div></div>
    </div>
    <div class="statband reveal" style="margin-top:48px">
      <div class="stat"><div class="n">100%</div><div class="l">Salesforce-focused</div></div>
      <div class="stat"><div class="n">Marketing Cloud</div><div class="l">flagship practice</div></div>
      <div class="stat"><div class="n">4</div><div class="l">industry practices</div></div>
      <div class="stat"><div class="n">AI-native</div><div class="l">delivery model</div></div>
    </div>
  </div>
</section>

<section class="blk alt" id="vision-mission">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">What drives us</span><h2>Vision &amp; mission</h2></div>
    <div class="grid g2 reveal" style="gap:24px">
      <div class="dark-card">
        <div class="klabel" style="color:#7FE9F5">Our vision</div>
        <h3 style="font-size:20px;margin:10px 0 12px">Make AI-first the default for Salesforce</h3>
        <p>We see a future where AI-first isn&rsquo;t a differentiator &mdash; it&rsquo;s simply how great Salesforce work gets done. Every program we touch should run on intelligent agents and expert people working side by side, producing outcomes that weren&rsquo;t realistic even a year ago. Our measure is simple: each engagement should leave a client more autonomous, more capable, and faster to value than we found them.</p>
      </div>
      <div class="card" style="background:var(--bg-alt)">
        <div class="klabel" style="color:var(--brand)">Our mission</div>
        <h3 style="font-size:20px;margin:10px 0 12px">Turn AI ambition into shipped outcomes</h3>
        <p>We help brands &mdash; and the partners who serve them &mdash; adopt AI, rethink how they work, and get measurably more from the Salesforce platform. AI runs through every stage of how we deliver, so timelines shrink and cost drops while quality holds steady. And through all of it, experienced people stay accountable for every decision we make on your behalf.</p>
      </div>
    </div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">What we stand for</span><h2>How we work</h2></div>
    <div class="grid g3 reveal">
      <div class="card hover"><h4>Depth over breadth</h4><p>We do one platform and go deep, so you get true specialists, not generalists.</p></div>
      <div class="card hover"><h4>AI, with humans accountable</h4><p>AI accelerates the work; experienced people own every decision and gate.</p></div>
      <div class="card hover"><h4>Outcomes, not hours</h4><p>We measure success by what ships and what it moves, not by activity.</p></div>
      <div class="card hover"><h4>Transparent delivery</h4><p>Clear plans, honest status, documented work you can audit.</p></div>
      <div class="card hover"><h4>Partner, not vendor</h4><p>We think about your roadmap, not just the current ticket.</p></div>
      <div class="card hover"><h4>Always improving</h4><p>Every engagement feeds our accelerators and makes the next one faster.</p></div>
    </div>
  </div>
</section>

<!-- Certifications & competencies -->
<section class="blk" id="certifications">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Certifications &amp; competencies</span>
      <h2>Credentialed across the Salesforce platform</h2>
      <p>Our team holds <strong>100+ Salesforce certifications</strong> spanning the platform &mdash; from Agentforce and Marketing Cloud to Data 360 and core Platform &mdash; so the people on your project bring proven, current expertise.</p>
    </div>
    <div class="statband reveal" style="margin-bottom:36px">
      <div class="stat"><div class="n">100+</div><div class="l">Salesforce certifications</div></div>
      <div class="stat"><div class="n">8</div><div class="l">products covered</div></div>
      <div class="stat"><div class="n">Partner</div><div class="l">Salesforce Consulting Partner</div></div>
      <div class="stat"><div class="n">100%</div><div class="l">Salesforce-focused team</div></div>
    </div>
    <div class="card reveal">
      <div class="mono" style="font-size:11.5px;color:var(--text-faint);letter-spacing:.1em;text-transform:uppercase;margin-bottom:14px">Certified across these products</div>
      <div class="tags" style="gap:9px">
        <span style="font-size:13px;padding:6px 12px">Agentforce</span>
        <span style="font-size:13px;padding:6px 12px">Agentforce Commerce</span>
        <span style="font-size:13px;padding:6px 12px">Agentforce Marketing</span>
        <span style="font-size:13px;padding:6px 12px">Agentforce Sales</span>
        <span style="font-size:13px;padding:6px 12px">Agentforce Service</span>
        <span style="font-size:13px;padding:6px 12px">Analytics</span>
        <span style="font-size:13px;padding:6px 12px">Data 360</span>
        <span style="font-size:13px;padding:6px 12px">Platform</span>
      </div>
    </div>  </div>
</section>


<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>Let's build something worth talking about.</h2>
  <p>Whether you're a brand or a partner who needs delivery muscle, we'd like to help.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/why-code-to-click">Why Code to Click</a></div>
</div></div></section>
</Base>
