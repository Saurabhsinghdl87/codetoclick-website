---
import Base from '../layouts/Base.astro';
const title = "Core Clouds — Code to Click";
const description = "Sales, Service and Experience Cloud implementations, re-implementations and custom Apex/LWC development — delivered by AI-accelerated Salesforce pods.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Services / Core Clouds</div>
    <span class="eyebrow kick">Sales &middot; Service &middot; Experience</span>
    <h1>The <span class="g">core clouds</span>, implemented right</h1>
    <p class="lede">Greenfield builds, rescues and re-implementations across Sales, Service and Experience Cloud &mdash; plus the custom Apex and Lightning Web Components that make Salesforce fit how you actually work.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Scope your build &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">What we implement</span><h2>Three clouds, one delivery team</h2></div>
    <div class="grid g3 reveal">
      <div class="card hover"><div class="svc-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg></div><h3>Sales Cloud</h3><p>Lead-to-cash, opportunity and forecasting, CPQ foundations, and sales productivity that reps actually adopt.</p><div class="tags"><span>Pipeline</span><span>Forecasting</span><span>CPQ</span></div></div>
      <div class="card hover"><div class="svc-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--violet)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div><h3>Service Cloud</h3><p>Case management, omni-channel routing, knowledge and self-service &mdash; with Agentforce-ready support built in.</p><div class="tags"><span>Omni-channel</span><span>Knowledge</span><span>Self-service</span></div></div>
      <div class="card hover"><div class="svc-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg></div><h3>Experience Cloud</h3><p>Portals, communities and partner sites &mdash; branded, secure, and connected to the same data your teams use.</p><div class="tags"><span>Portals</span><span>Communities</span><span>Partner sites</span></div></div>
    </div>
  </div>
</section>

<section class="blk alt">
  <div class="wrap">
    <div class="frow reveal">
      <div class="fig soft"><div class="imgslot"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="1.5"><path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div></div>
      <div>
        <span class="eyebrow">How we deliver</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Clean architecture, custom where it counts</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">We favor declarative first and reach for code only where it adds real value &mdash; keeping your org maintainable and upgrade-safe.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Org design, data model and security architecture</li>
          <li><span class="ck">&rsaquo;</span> Flows and automation before custom code</li>
          <li><span class="ck">&rsaquo;</span> Apex, LWC and integrations where needed</li>
          <li><span class="ck">&rsaquo;</span> Data migration, dedupe and quality</li>
          <li><span class="ck">&rsaquo;</span> AI-generated test coverage and documentation</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>New build or a rescue&mdash;let's talk.</h2>
  <p>Tell us about your org and goals. We'll bring a plan and an AI-accelerated pod to deliver it.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/work">See our work</a></div>
</div></div></section>
</Base>
