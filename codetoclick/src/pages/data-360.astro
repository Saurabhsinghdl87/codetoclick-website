---
import Base from '../layouts/Base.astro';
const title = "Data 360 — Code to Click";
const description = "Salesforce Data 360 (formerly Data Cloud) — identity resolution, segmentation, activation and data migrations that give every team one view of the customer.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Services / Data 360</div>
    <span class="eyebrow kick">Formerly Data Cloud</span>
    <h1>One <span class="g">customer profile</span>, every team</h1>
    <p class="lede">Salesforce Data 360 unifies your data into a single, real-time profile &mdash; resolving identity, powering segmentation and activating audiences across Marketing Cloud, Agentforce and the rest of your stack.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Unify your data &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">What we do with Data 360</span><h2>From raw data to activated audience</h2></div>
    <div class="grid g4 reveal">
      <div class="card hover"><div class="klabel">Ingest</div><h4 style="margin-top:8px">Data streams</h4><p style="font-size:13.5px">Connect sources into DLOs &mdash; CRM, web, commerce, files and external systems.</p></div>
      <div class="card hover"><div class="klabel">Resolve</div><h4 style="margin-top:8px">Identity resolution</h4><p style="font-size:13.5px">Unify records into a single individual with rulesets you can trust.</p></div>
      <div class="card hover"><div class="klabel">Model</div><h4 style="margin-top:8px">Data model &amp; graphs</h4><p style="font-size:13.5px">Map to DMOs and build data graphs that power marketing and AI.</p></div>
      <div class="card hover"><div class="klabel">Activate</div><h4 style="margin-top:8px">Segments &amp; activation</h4><p style="font-size:13.5px">Build segments and activate to Marketing Cloud, ads and partners.</p></div>
    </div>
    <div class="statband reveal" style="margin-top:38px">
      <div class="stat"><div class="n">1</div><div class="l">unified profile per customer</div></div>
      <div class="stat"><div class="n">Real-time</div><div class="l">data &amp; segmentation</div></div>
      <div class="stat"><div class="n">AI-ready</div><div class="l">grounding for Agentforce</div></div>
      <div class="stat"><div class="n">Any source</div><div class="l">CRM, web, commerce, files</div></div>
    </div>
  </div>
</section>

<section class="blk alt">
  <div class="wrap">
    <div class="frow flip reveal">
      <div>
        <span class="eyebrow">Why it matters</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">The foundation under everything</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">Marketing Cloud journeys, Agentforce agents and analytics are only as good as the data beneath them. Data 360 is the layer that makes them accurate, personal and real-time.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Powers 1:1 personalization in Marketing Cloud</li>
          <li><span class="ck">&rsaquo;</span> Grounds Agentforce agents in trusted data</li>
          <li><span class="ck">&rsaquo;</span> Retires brittle point-to-point integrations</li>
          <li><span class="ck">&rsaquo;</span> Gives every team the same customer view</li>
        </ul>
      </div>
      <div class="fig grad"><div class="imgslot" style="color:#fff"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>IMAGE / GRAPHIC<br>Unified profile &amp; identity graph</div></div>
    </div>
  </div>
</section>

<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>Give every team one view of the customer.</h2>
  <p>We'll assess your sources and design an identity and activation plan built for marketing and AI.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/marketing-cloud">See Marketing Cloud</a></div>
</div></div></section>
</Base>
