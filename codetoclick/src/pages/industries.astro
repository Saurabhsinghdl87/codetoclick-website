---
import Base from '../layouts/Base.astro';
const title = "Industries — Higher Ed, Nonprofit, Retail | Code to Click";
const description = "Deep Salesforce and Marketing Cloud playbooks for Higher Education, Nonprofit, Professional Services and Retail.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Industries</div>
    <span class="eyebrow kick">Industry playbooks</span>
    <h1>We go <span class="g">deep</span>, not wide</h1>
    <p class="lede">Four industries where our Marketing Cloud and Salesforce expertise turns into repeatable playbooks &mdash; so you get a partner who already knows your motions, metrics and audiences.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Talk to a specialist &rarr;</a></div>
  </div>
</section>

<!-- Higher Education -->
<section class="blk" id="higher-ed">
  <div class="wrap">
    <div class="frow reveal">
      <div>
        <span class="eyebrow">Higher Education</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Fill the funnel, from RFI to alumni</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">Our flagship industry. We build the full enrollment marketing lifecycle in Marketing Cloud, backed by Education Cloud and Data 360.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> RFI, prospect and stealth-applicant nurture</li>
          <li><span class="ck">&rsaquo;</span> Application completion &amp; admit-to-enrolled (yield)</li>
          <li><span class="ck">&rsaquo;</span> Summer melt mitigation &amp; orientation</li>
          <li><span class="ck">&rsaquo;</span> Events, campus visits and alumni/advancement</li>
        </ul>
        <a class="arrow" href="/marketing-cloud#journeys">See the journey library &rarr;</a>
      </div>
      <div class="fig soft"><div class="imgslot"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--violet)" stroke-width="1.5"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-5"/></svg></div></div>
    </div>
  </div>
</section>

<!-- Nonprofit -->
<section class="blk alt" id="nonprofit">
  <div class="wrap">
    <div class="frow flip reveal">
      <div>
        <span class="eyebrow">Nonprofit</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Turn supporters into lifelong donors</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">Donor journeys and fundraising built on Marketing Cloud and Nonprofit Cloud, unified on a single Data 360 supporter profile.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Welcome, cultivation and giving journeys</li>
          <li><span class="ck">&rsaquo;</span> Campaign &amp; appeal automation</li>
          <li><span class="ck">&rsaquo;</span> Recurring giving and lapsed-donor reactivation</li>
          <li><span class="ck">&rsaquo;</span> Event, volunteer and stewardship engagement</li>
        </ul>
      </div>
      <div class="fig soft"><div class="imgslot"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="1.5"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21l8.8-8.3a5 5 0 0 0 0-7.1z"/></svg></div></div>
    </div>
  </div>
</section>

<!-- Professional Services -->
<section class="blk" id="professional-services">
  <div class="wrap">
    <div class="frow reveal">
      <div>
        <span class="eyebrow">Professional Services</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Win, deliver and grow clients</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">Agentforce Marketing with Agentforce Sales &amp; Service to run the full client lifecycle, from first touch to renewal and expansion.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Lead nurture and thought-leadership programs</li>
          <li><span class="ck">&rsaquo;</span> Proposal, onboarding and delivery comms</li>
          <li><span class="ck">&rsaquo;</span> Client health, renewal and cross-sell journeys</li>
          <li><span class="ck">&rsaquo;</span> Event and webinar engagement</li>
        </ul>
      </div>
      <div class="fig soft"><div class="imgslot"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--brand-strong)" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg></div></div>
    </div>
  </div>
</section>

<!-- Retail -->
<section class="blk alt" id="retail">
  <div class="wrap">
    <div class="frow flip reveal">
      <div>
        <span class="eyebrow">Retail &amp; Commerce</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Personal, profitable, cross-channel</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">Personalized journeys, loyalty and clienteling on Marketing Cloud, Data 360 and Commerce &mdash; tuned for conversion and repeat purchase.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Welcome, browse and cart-abandon journeys</li>
          <li><span class="ck">&rsaquo;</span> Loyalty, replenishment and win-back</li>
          <li><span class="ck">&rsaquo;</span> 1:1 personalization powered by Data 360</li>
          <li><span class="ck">&rsaquo;</span> Post-purchase and clienteling</li>
        </ul>
      </div>
      <div class="fig soft"><div class="imgslot"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5"><path d="M6 2 3 6v14a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/></svg></div></div>
    </div>
  </div>
</section>

<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>A partner who already knows your playbook.</h2>
  <p>Tell us your industry and goals &mdash; we'll bring relevant journeys and accelerators to the first call.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/work">See our work</a></div>
</div></div></section>
</Base>
