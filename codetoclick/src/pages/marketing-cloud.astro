---
import Base from '../layouts/Base.astro';
const title = "Marketing Cloud (Agentforce Marketing) — Code to Click";
const description = "Agentforce Marketing (formerly Marketing Cloud), done right — MCE, Marketing Cloud Growth & Advanced, and Account Engagement, unified by Data 360 and AI. Deep Higher Ed, Nonprofit, Professional Services and Retail playbooks.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Services / Marketing Cloud</div>
    <span class="eyebrow kick">Flagship practice &middot; Agentforce Marketing</span>
    <h1>Marketing Cloud, from <span class="g">strategy to send</span></h1>
    <p class="lede">Now Agentforce Marketing (formerly Marketing Cloud). Whether you run classic Marketing Cloud Engagement, are moving to the new Marketing Cloud Next editions, or drive B2B on Account Engagement &mdash; we architect, build and optimize the whole lifecycle, with Data 360 and AI underneath for a single, intelligent view of every customer.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Talk Marketing Cloud &rarr;</a><a class="btn btn-light" href="#journeys">See Higher Ed journeys</a></div>
  </div>
</section>

<!-- editions -->
<section class="blk">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">What we work in</span>
      <h2>Every edition, one team</h2>
      <p>We meet you where your marketing stack is today and take you where it's going next.</p>
    </div>
    <div class="grid g2 reveal">
      <div class="card hover"><div class="klabel">MCE</div><h3 style="margin-top:8px">Marketing Cloud Engagement</h3><p>Journey Builder, Email &amp; Mobile Studio, Automation Studio, Content Builder and AMPscript &mdash; the full classic Marketing Cloud toolkit, tuned for scale and deliverability.</p><div class="tags"><span>Journey Builder</span><span>AMPscript</span><span>Automation Studio</span></div></div>
      <div class="card hover"><div class="klabel">Marketing Cloud Next</div><h3 style="margin-top:8px">Growth &amp; Advanced</h3><p>Greenfield builds on the new core + Data 360 platform &mdash; Flow-based orchestration, unified profiles, Einstein and Agentforce for marketing, built natively on Salesforce.</p><div class="tags"><span>MC Growth</span><span>MC Advanced</span><span>Data 360</span></div></div>
      <div class="card hover"><div class="klabel">MCAE</div><h3 style="margin-top:8px">Account Engagement (Pardot)</h3><p>B2B nurture, lead scoring &amp; grading, and tight sales alignment &mdash; connecting marketing to the pipeline in Agentforce Sales (formerly Sales Cloud).</p><div class="tags"><span>Nurture</span><span>Scoring</span><span>Sales alignment</span></div></div>
      <div class="card hover"><div class="klabel">Migration</div><h3 style="margin-top:8px">MCE &rarr; Marketing Cloud Next</h3><p>Assessment, coexistence and staged migration &mdash; move to the new platform without disrupting live programs, with data and journeys carried across cleanly.</p><div class="tags"><span>Assessment</span><span>Coexistence</span><span>Cutover</span></div></div>
    </div>
  </div>
</section>

<!-- higher ed journeys -->
<section class="blk alt" id="journeys">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Higher Education</span>
      <h2>Higher Education marketing, journey by journey</h2>
      <p>Our deepest campaign library. These are the journeys we build and optimize across the enrollment funnel and beyond.</p>
    </div>
    <div class="grid g4 reveal">
      <div class="card hover" style="padding:20px"><div class="klabel">Inquiry</div><h4 style="margin-top:8px">RFI Journey</h4><p style="font-size:13.5px">Capture Request-for-Information leads and nurture them from first touch to inquiry.</p></div>
      <div class="card hover" style="padding:20px"><div class="klabel">Inquiry</div><h4 style="margin-top:8px">Prospect Nurture</h4><p style="font-size:13.5px">Warm inquiries and stealth prospects toward a started application.</p></div>
      <div class="card hover" style="padding:20px"><div class="klabel">Applicant</div><h4 style="margin-top:8px">Application Journey</h4><p style="font-size:13.5px">Drive application starts and completion, cutting drop-off at every step.</p></div>
      <div class="card hover" style="padding:20px"><div class="klabel">Yield</div><h4 style="margin-top:8px">Admit-to-Enrolled</h4><p style="font-size:13.5px">Convert admits to deposits and enrollments with a personalized yield journey.</p></div>
      <div class="card hover" style="padding:20px"><div class="klabel">Yield</div><h4 style="margin-top:8px">Melt Mitigation</h4><p style="font-size:13.5px">Keep committed students engaged and enrolled through summer melt.</p></div>
      <div class="card hover" style="padding:20px"><div class="klabel">Engage</div><h4 style="margin-top:8px">Event &amp; Campus Visit</h4><p style="font-size:13.5px">Open house, tours and webinar invite-to-attend-to-follow-up journeys.</p></div>
      <div class="card hover" style="padding:20px"><div class="klabel">Reactivate</div><h4 style="margin-top:8px">Re-Engagement</h4><p style="font-size:13.5px">Win back dormant inquiries and incomplete applications before deadlines.</p></div>
      <div class="card hover" style="padding:20px"><div class="klabel">Advancement</div><h4 style="margin-top:8px">Alumni &amp; Advancement</h4><p style="font-size:13.5px">Giving, stewardship and lifelong engagement for graduates and donors.</p></div>
    </div>
  </div>
</section>

<!-- capabilities + AI -->
<section class="blk">
  <div class="wrap">
    <div class="frow reveal">
      <div>
        <span class="eyebrow">Capabilities</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Strategy, build and optimization</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">A full-lifecycle team &mdash; not just builders. We shape the strategy, stand up the platform, and keep improving performance after go-live.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Lifecycle &amp; journey strategy, messaging and cadence</li>
          <li><span class="ck">&rsaquo;</span> Data model, subscriber/contact architecture &amp; deliverability</li>
          <li><span class="ck">&rsaquo;</span> Template systems, content blocks and dynamic personalization</li>
          <li><span class="ck">&rsaquo;</span> Preference centers, consent &amp; compliance</li>
          <li><span class="ck">&rsaquo;</span> Reporting, A/B testing and optimization sprints</li>
        </ul>
      </div>
      <div class="fig soft">
        <div class="imgslot">
          <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="1.5"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </div>
      </div>
    </div>
    <div class="dark-card reveal" style="margin-top:40px">
      <span class="eyebrow" style="color:#C4A9FF">AI-native marketing</span>
      <h3 style="font-size:22px;margin:12px 0 8px">Agentforce &amp; Einstein, working the campaign</h3>
      <p style="max-width:70ch">Beyond building faster, we put AI to work inside your marketing &mdash; Agentforce agents for campaign ops and content, Einstein for send-time, engagement scoring and next-best-action. Intelligence that keeps running after we hand over.</p>
      <div class="chips"><span>Agentforce Marketing</span><span>Einstein STO</span><span>Engagement scoring</span><span>Content generation</span></div>
    </div>
  </div>
</section>

<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>Let's build your next Marketing Cloud program.</h2>
  <p>From a single journey to a full migration &mdash; tell us where you are and we'll map the fastest path.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/work">See our work</a></div>
</div></div></section>
</Base>
