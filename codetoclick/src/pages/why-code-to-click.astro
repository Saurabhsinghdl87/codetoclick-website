---
import Base from '../layouts/Base.astro';
const title = "Why Code to Click — Code to Click";
const description = "An AI-native Salesforce delivery model — faster, more economical, quality held constant. Two ways to engage: directly, or as your delivery arm.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Why Code to Click</div>
    <span class="eyebrow kick">AI-native delivery</span>
    <h1>Faster, <span class="g">without cutting corners</span></h1>
    <p class="lede">We're a Salesforce-first partner built around one idea: AI woven through the whole delivery lifecycle. That means shorter timelines and lower cost, with quality held constant by AI-generated tests and expert human review at every gate.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Work with us &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="sec-head center reveal"><span class="eyebrow c">Our delivery model</span><h2>An AI-native way to deliver Salesforce</h2><p>Not a bolt-on. Intelligence runs from the first workshop to the last regression test.</p></div>
    <div class="lifecycle reveal">
      <div class="stage"><div class="s-no">01</div><h4>Discovery &amp; Requirements</h4><p><span class="k">AI</span>Transcribes workshops, drafts user stories &amp; BRDs.</p></div>
      <div class="stage"><div class="s-no">02</div><h4>Solution Design</h4><p><span class="k">AI</span>Proposes data models, generates design docs.</p></div>
      <div class="stage"><div class="s-no">03</div><h4>Build &amp; Configure</h4><p><span class="k">AI</span>Generates Apex/LWC, flows and config.</p></div>
      <div class="stage"><div class="s-no">04</div><h4>Testing &amp; QA</h4><p><span class="k">AI</span>Writes test classes, automates regression.</p></div>
      <div class="stage"><div class="s-no">05</div><h4>Deploy &amp; Release</h4><p><span class="k">AI</span>Drafts release notes, scans for risk.</p></div>
      <div class="stage"><div class="s-no">06</div><h4>Support &amp; Optimize</h4><p><span class="k">AI</span>Agentforce support, monitoring, triage.</p></div>
    </div>
  </div>
</section>

<section class="blk alt">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">Two ways to engage</span><h2>Directly, or as your delivery arm</h2></div>
    <div class="grid g2 reveal">
      <div class="dark-card"><h3 style="font-size:21px">Directly, as your partner</h3><p>You get a Salesforce-first team that owns strategy through delivery &mdash; ideal for brands and organizations building on Salesforce.</p><div class="chips"><span>Implementations</span><span>Marketing Cloud</span><span>Managed services</span></div></div>
      <div class="card hover"><h3 style="font-size:21px">As a partner's delivery arm</h3><p>You get an AI-native delivery team behind your firm &mdash; extra capacity and Salesforce depth, delivered under your brand and process.</p><div class="tags"><span>White-label</span><span>Overflow capacity</span><span>Specialist skills</span></div></div>
    </div>
    <div class="sec-head reveal" style="margin-top:52px;margin-bottom:26px"><h2 style="font-size:24px">Engagement models</h2></div>
    <div class="grid g4 reveal">
      <div class="model"><div class="k">Model 01</div><h4>Dedicated Pods</h4><p>A ring-fenced team scaled to your roadmap, with US-hours overlap.</p></div>
      <div class="model"><div class="k">Model 02</div><h4>Project / Fixed Scope</h4><p>Defined deliverables, milestones and price.</p></div>
      <div class="model"><div class="k">Model 03</div><h4>Managed Services</h4><p>Monthly retainer for run-and-enhance.</p></div>
      <div class="model"><div class="k">Model 04</div><h4>Staff Augmentation</h4><p>Certified specialists in your existing team.</p></div>
    </div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="frow reveal">
      <div class="fig" style="padding:0;border:none;overflow:hidden"><img src="/assets/why-us.png" alt="Secure, AI-native Salesforce delivery with human review at every gate" style="width:100%;height:100%;object-fit:cover;border-radius:var(--r);display:block" /></div>
      <div>
        <span class="eyebrow">Security &amp; trust</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Enterprise-grade, by default</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">Speed never comes at the expense of security. We work to your controls and keep humans accountable for every change.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Least-privilege access and secure environments</li>
          <li><span class="ck">&rsaquo;</span> Human review and approval at every gate</li>
          <li><span class="ck">&rsaquo;</span> Data handling aligned to your policies</li>
          <li><span class="ck">&rsaquo;</span> Documented, auditable delivery</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="blk alt" style="padding-top:60px;padding-bottom:60px"><div class="wrap"><div class="ctaband reveal">
  <h2>See what AI-native delivery feels like.</h2>
  <p>Bring us a real project and we'll show you the plan, the pod and the timeline.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/work">See our work</a></div>
</div></div></section>
</Base>
