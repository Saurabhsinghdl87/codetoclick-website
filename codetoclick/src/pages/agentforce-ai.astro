---
import Base from '../layouts/Base.astro';
const title = "Agentforce & AI — Code to Click";
const description = "Agentforce agents, Einstein and prompt/automation design — turning Salesforce into an AI-driven system of action, delivered by an AI-native team.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Services / Agentforce &amp; AI</div>
    <span class="eyebrow kick">Agentforce &middot; Einstein</span>
    <h1>Turn Salesforce into an <span class="g">AI system of action</span></h1>
    <p class="lede">We design, build and deploy Agentforce agents and Einstein features that do real work &mdash; resolving cases, qualifying leads, drafting content and taking next-best actions, all grounded in your Salesforce data.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Explore Agentforce &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">What we build</span><h2>Agents that earn their seat</h2><p>Scoped to a clear job, grounded in your data, and measured on outcomes.</p></div>
    <div class="grid g3 reveal">
      <div class="card hover"><div class="klabel">Service</div><h4 style="margin-top:8px">Support agents</h4><p>Deflect and resolve tier-1 cases with grounded answers, hand off cleanly to humans when needed.</p></div>
      <div class="card hover"><div class="klabel">Sales</div><h4 style="margin-top:8px">SDR &amp; qualification agents</h4><p>Qualify inbound, answer product questions and book meetings, updating the CRM as they go.</p></div>
      <div class="card hover"><div class="klabel">Marketing</div><h4 style="margin-top:8px">Campaign &amp; content agents</h4><p>Draft campaigns, segments and content variants for marketer review inside Marketing Cloud.</p></div>
      <div class="card hover"><div class="klabel">Ops</div><h4 style="margin-top:8px">Internal copilots</h4><p>Answer policy and process questions, summarize records and automate routine admin.</p></div>
      <div class="card hover"><div class="klabel">Einstein</div><h4 style="margin-top:8px">Predictions &amp; scoring</h4><p>Lead/opportunity scoring, next-best-action and send-time optimization across the org.</p></div>
      <div class="card hover"><div class="klabel">Foundations</div><h4 style="margin-top:8px">Prompt &amp; data grounding</h4><p>Prompt templates, retrieval on Data 360, guardrails, testing and human-in-the-loop design.</p></div>
    </div>
  </div>
</section>

<section class="blk alt">
  <div class="wrap">
    <div class="sec-head center reveal"><span class="eyebrow c">How we get there</span><h2>From use case to live agent</h2></div>
    <div class="lifecycle reveal">
      <div class="stage"><div class="s-no">01</div><h4>Identify</h4><p>Pick a high-value, well-bounded job for the agent.</p></div>
      <div class="stage"><div class="s-no">02</div><h4>Ground</h4><p>Connect the data and knowledge on Data 360.</p></div>
      <div class="stage"><div class="s-no">03</div><h4>Design</h4><p>Prompts, actions, guardrails and handoffs.</p></div>
      <div class="stage"><div class="s-no">04</div><h4>Build</h4><p>Configure agent, actions and integrations.</p></div>
      <div class="stage"><div class="s-no">05</div><h4>Test</h4><p>Evaluate accuracy, safety and edge cases.</p></div>
      <div class="stage"><div class="s-no">06</div><h4>Launch</h4><p>Deploy, monitor and improve on real usage.</p></div>
    </div>
  </div>
</section>

<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>Find your first high-value agent.</h2>
  <p>We'll run a short discovery and point you at the Agentforce use case with the fastest payback.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/data-360">See Data 360</a></div>
</div></div></section>
</Base>
