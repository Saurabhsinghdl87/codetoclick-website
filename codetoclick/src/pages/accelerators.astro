---
import Base from '../layouts/Base.astro';
const title = "Accelerators — Code to Click";
const description = "Reusable, AI-built assets — assessments, migration kits, identity blueprints and starter agents — that shorten every Salesforce engagement.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Services / Accelerators</div>
    <span class="eyebrow kick">Reusable AI assets</span>
    <h1>Start ahead with <span class="g">accelerators</span></h1>
    <p class="lede">Pre-built, AI-assisted assets that take the blank-page time out of a project &mdash; assessments, migration kits, blueprints and starter agents we bring to day one. This library grows with every engagement.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">See what fits &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">The library</span><h2>What we bring to day one</h2><p>A starter set &mdash; we'll name and expand these as the library grows.</p></div>
    <div class="grid g3 reveal">
      <div class="card hover" style="background:var(--grad-soft)"><div class="klabel">ACC 01</div><h4 style="margin-top:8px">MCE Org Assessment</h4><p>Rapid audit of a Marketing Cloud org &mdash; deliverability, data, journeys and quick wins.</p></div>
      <div class="card hover" style="background:var(--grad-soft)"><div class="klabel">ACC 02</div><h4 style="margin-top:8px">MCE &rarr; Next Migration Kit</h4><p>Assessment templates, mapping and a staged plan for moving to Marketing Cloud Next.</p></div>
      <div class="card hover" style="background:var(--grad-soft)"><div class="klabel">ACC 03</div><h4 style="margin-top:8px">Data 360 Identity Blueprint</h4><p>Reference model, DLO/DMO mapping and identity ruleset starting points.</p></div>
      <div class="card hover" style="background:var(--grad-soft)"><div class="klabel">ACC 04</div><h4 style="margin-top:8px">Agentforce Starter Agents</h4><p>Pre-scoped service and sales agent templates with guardrails and tests.</p></div>
      <div class="card hover" style="background:var(--grad-soft)"><div class="klabel">ACC 05</div><h4 style="margin-top:8px">Higher Ed Journey Pack</h4><p>RFI, application and yield journey templates ready to tailor in Marketing Cloud.</p></div>
      <div class="card hover" style="background:var(--grad-soft)"><div class="klabel">ACC 06</div><h4 style="margin-top:8px">Your accelerator here</h4><p>Placeholder &mdash; we'll add more as the practice builds new reusable assets.</p></div>
    </div>
  </div>
</section>

<section class="blk alt">
  <div class="wrap">
    <div class="frow reveal">
      <div class="fig soft"><div class="imgslot"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--violet)" stroke-width="1.5"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>IMAGE / GRAPHIC<br>Accelerator kit contents</div></div>
      <div>
        <span class="eyebrow">Why it matters</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:14px 0 0">Less setup, more outcome</h2>
        <p style="color:var(--text-muted);margin:14px 0 0">Accelerators compress the early, low-value phases of a project so more of your budget goes to work that moves the needle.</p>
        <ul class="list-check">
          <li><span class="ck">&rsaquo;</span> Faster starts &mdash; proven templates, not blank pages</li>
          <li><span class="ck">&rsaquo;</span> Fewer risks &mdash; patterns we've run before</li>
          <li><span class="ck">&rsaquo;</span> Consistent quality across every engagement</li>
          <li><span class="ck">&rsaquo;</span> Continuously improved by our AI-native delivery</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>Which accelerator fits your project?</h2>
  <p>Tell us your goal and we'll bring the right starting assets to your first workshop.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/marketing-cloud">Explore services</a></div>
</div></div></section>
</Base>
