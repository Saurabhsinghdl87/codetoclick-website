---
import Base from '../layouts/Base.astro';
const title = "Managed Services & AMS — Code to Click";
const description = "Dedicated offshore pods for run-and-enhance Salesforce support — admin, releases, enhancements and org health at a predictable monthly rate, with US-hours overlap.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Services / Managed Services</div>
    <span class="eyebrow kick">Managed Services &middot; AMS</span>
    <h1>Run and enhance, <span class="g">without the overhead</span></h1>
    <p class="lede">A dedicated pod that keeps your Salesforce healthy and always improving &mdash; admin, support, releases and a steady stream of enhancements, at a predictable monthly rate with US-hours overlap.</p>
    <div class="cta"><a class="btn btn-primary" href="/contact">Get a pod &rarr;</a></div>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">What's included</span><h2>Everything to keep your org moving</h2></div>
    <div class="grid g3 reveal">
      <div class="card hover"><h4>Admin &amp; support</h4><p>User management, day-to-day requests, incident triage and resolution.</p></div>
      <div class="card hover"><h4>Enhancements</h4><p>A prioritized backlog of improvements delivered every sprint.</p></div>
      <div class="card hover"><h4>Release management</h4><p>Seasonal release readiness, regression testing and safe deployments.</p></div>
      <div class="card hover"><h4>Org health</h4><p>Technical debt, security review, data quality and performance.</p></div>
      <div class="card hover"><h4>Reporting &amp; dashboards</h4><p>New reports, dashboards and analytics as your needs evolve.</p></div>
      <div class="card hover"><h4>Roadmap advisory</h4><p>Quarterly planning to align the backlog with your priorities.</p></div>
    </div>
  </div>
</section>

<section class="blk alt">
  <div class="wrap">
    <div class="sec-head reveal"><span class="eyebrow">How it works</span><h2>A pod that feels like your team</h2></div>
    <div class="grid g4 reveal">
      <div class="model"><div class="k">Step 01</div><h4>Onboard</h4><p>We learn your org, backlog and priorities in a short ramp.</p></div>
      <div class="model"><div class="k">Step 02</div><h4>Stabilize</h4><p>Clear the queue, fix quick wins and set SLAs.</p></div>
      <div class="model"><div class="k">Step 03</div><h4>Enhance</h4><p>Deliver a steady sprint cadence of improvements.</p></div>
      <div class="model"><div class="k">Step 04</div><h4>Advise</h4><p>Plan ahead each quarter and grow with you.</p></div>
    </div>
    <div class="note reveal" style="margin-top:26px"><span class="mono">AI-accelerated &rarr;</span><span>The same AI-native delivery runs through managed services &mdash; faster tickets, AI-generated tests and documentation, and more enhancement throughput per sprint.</span></div>
  </div>
</section>

<section class="blk" style="padding-top:20px"><div class="wrap"><div class="ctaband reveal">
  <h2>Hand off run-and-enhance to a team that cares.</h2>
  <p>Tell us about your org and volume, and we'll propose a right-sized pod and SLA.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a><a class="btn btn-light" href="/why-code-to-click">Why Code to Click</a></div>
</div></div></section>
</Base>
