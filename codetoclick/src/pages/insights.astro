---
import Base from '../layouts/Base.astro';
const title = "Insights — Code to Click";
const description = "Practical perspectives on Salesforce, Marketing Cloud, Agentforce, Data 360 and AI-native delivery.";
---
<Base title={title} description={description}>
<section class="phero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a> / Insights</div>
    <span class="eyebrow kick">Insights</span>
    <h1>Ideas worth <span class="g">shipping</span></h1>
    <p class="lede">Practical perspectives on Marketing Cloud, Agentforce, Data 360 and AI-native delivery. Placeholder posts below &mdash; your thought leadership will live here.</p>
  </div>
</section>

<section class="blk">
  <div class="wrap">
    <!-- featured -->
    <div class="reveal" style="margin-bottom:34px">
      <a class="card hover" href="/blog-mce-migration" style="display:grid;grid-template-columns:1.1fr 1fr;gap:0;padding:0;overflow:hidden">
        <div class="cover" style="height:auto;min-height:240px;border-radius:0;background:linear-gradient(135deg,#2F6BFF,#8B5CF6)"></div>
        <div style="padding:30px">
          <div class="klabel">Featured &middot; Marketing Cloud</div>
          <h3 style="font-size:22px;margin:10px 0 8px">Planning your MCE to Marketing Cloud Next migration</h3>
          <p style="color:var(--text-muted);font-size:15px">What actually changes, how to assess readiness, and a staged path that keeps live programs running.</p>
          <span class="arrow">Read the guide &rarr;</span>
        </div>
      </a>
    </div>
    <div class="grid g3 reveal">
      <a class="card hover" href="/blog-agentforce-first" style="padding:0;overflow:hidden"><div class="cover" style="background:linear-gradient(135deg,#8B5CF6,#2F6BFF)"></div><div style="padding:20px 22px 24px"><div class="mono" style="font-size:11px;color:var(--text-faint)">AGENTFORCE &middot; 5 MIN</div><h4 style="margin:8px 0 0">Where Agentforce actually pays off first</h4></div></a>
      <a class="card hover" href="/blog-rfi-journey" style="padding:0;overflow:hidden"><div class="cover" style="background:linear-gradient(135deg,#2F6BFF,#22D3EE)"></div><div style="padding:20px 22px 24px"><div class="mono" style="font-size:11px;color:var(--text-faint)">HIGHER ED &middot; 6 MIN</div><h4 style="margin:8px 0 0">Designing an RFI-to-Enrolled journey</h4></div></a>
      <a class="card hover" href="/blog-data360-identity" style="padding:0;overflow:hidden"><div class="cover" style="background:linear-gradient(135deg,#22D3EE,#8B5CF6)"></div><div style="padding:20px 22px 24px"><div class="mono" style="font-size:11px;color:var(--text-faint)">DATA 360 &middot; 5 MIN</div><h4 style="margin:8px 0 0">Identity resolution in Data 360, without the headaches</h4></div></a>
      <div class="card" style="padding:0;overflow:hidden;opacity:.72"><div class="cover" style="background:linear-gradient(135deg,#22D3EE,#2F6BFF)"></div><div style="padding:20px 22px 24px"><div class="mono" style="font-size:11px;color:var(--text-faint)">DELIVERY &middot; COMING SOON</div><h4 style="margin:8px 0 0">How AI cuts a Salesforce build timeline</h4></div></div>
      <div class="card" style="padding:0;overflow:hidden;opacity:.72"><div class="cover" style="background:linear-gradient(135deg,#8B5CF6,#22D3EE)"></div><div style="padding:20px 22px 24px"><div class="mono" style="font-size:11px;color:var(--text-faint)">NONPROFIT &middot; COMING SOON</div><h4 style="margin:8px 0 0">Donor journeys that actually convert</h4></div></div>
      <div class="card" style="padding:0;overflow:hidden;opacity:.72"><div class="cover" style="background:linear-gradient(135deg,#2F6BFF,#8B5CF6)"></div><div style="padding:20px 22px 24px"><div class="mono" style="font-size:11px;color:var(--text-faint)">RETAIL &middot; COMING SOON</div><h4 style="margin:8px 0 0">Personalization that lifts repeat purchase</h4></div></div>
    </div>
    <div class="ph-note reveal" style="margin-top:20px">// four articles are written and live; the greyed cards are drafts to publish next</div>
  </div>
</section>

<section class="blk alt" style="padding-top:56px;padding-bottom:56px"><div class="wrap"><div class="ctaband reveal">
  <h2>Prefer to talk it through?</h2>
  <p>Bring your Salesforce or Marketing Cloud question &mdash; we're happy to help.</p>
  <div class="cta"><a class="btn btn-primary" href="/contact">Book a consult &rarr;</a></div>
</div></div></section>
</Base>
